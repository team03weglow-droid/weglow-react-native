{
  "name": "weglow-react-native",
  "description": "WeGlow 2.0 mobile application",
  "license": "UNLICENSED",
  "version": "0.1.0",
  "main": "index.ts",
  "dependencies": {
    "@react-navigation/native": "7.5.1",
    "@react-navigation/native-stack": "7.21.0",
    "expo": "~58.0.23",
    "expo-dev-client": "~58.0.18",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "onnxruntime-react-native": "1.24.3",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "~19.3.0",
    "eslint": "9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "10.1.8",
    "expo-doctor": "1.21.6",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --import tsx --test src/app/bootstrap/environment.test.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
